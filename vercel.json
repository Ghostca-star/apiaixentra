{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/ask",     "destination": "/api" },
    { "source": "/api/ask", "destination": "/api" },
    { "source": "/health",  "destination": "/api" },
    { "source": "/",        "destination": "/api" }
  ]
}
